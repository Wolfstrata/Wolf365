// Wolf365 data model.
//
// Conventions:
// - All secret material (connector client secrets, OAuth refresh/access tokens)
//   is stored ONLY in fields suffixed `Enc` and is app-level encrypted via
//   src/lib/crypto.ts before it ever reaches the database. Never store secrets
//   in plaintext columns.
// - Source-of-truth customer records from each connector live in their own
//   tables (QboCustomer, TdSynnexCustomer, ...) and are linked to the internal
//   master `Client` via mapping rows so we can detect discrepancies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMINISTRATOR // Full control — everything, incl. connector credentials, security, users
  POWER_USER // Operate billing & run syncs/tests, but cannot change connector credentials or admin settings
  FINANCIAL_POWER_USER // Like Power User but Finance/CRM/Reconciliation/Connector-Data only — no Administration
  SALES // CRM only — manage opportunities and view the sales forecast
  SILVERFANG_ADMIN // Full control of the SilverFang ticketing/PSA module, incl. its configuration
  SILVERFANG_USER // Work tickets and log time in SilverFang; no configuration or approvals
  REVIEWER // Read-only — view numbers, charts and reports; no changes, no billing, no syncs
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(REVIEWER)
  // Entra object id / group claims captured at login for traceability.
  entraOid      String?   @unique
  disabled      Boolean   @default(false)
  // IANA timezone for displaying timestamps (e.g. "America/Toronto"). Null = UTC.
  timezone      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
  sfChangeLogs SfChangeLog[]
  ownedOpportunities   CrmOpportunity[] @relation("OpportunityOwner")
  createdOpportunities CrmOpportunity[] @relation("OpportunityCreator")
  createdBackups       Backup[]         @relation("BackupCreator")
  salesQuotas          SalesQuota[]     @relation("SalesQuotaUser")
  salesRepComp         SalesRepComp?    @relation("SalesRepCompUser")

  // SilverFang (ticketing / PSA).
  sfTechProfile        SfTechProfile?
  sfAssignedTickets    SfTicket[]     @relation("SfTicketAssignee")
  sfCreatedTickets     SfTicket[]     @relation("SfTicketCreator")
  sfTimeEntries        SfTimeEntry[]  @relation("SfTimeEntryUser")
  sfTimesheets         SfTimesheet[]  @relation("SfTimesheetUser")
  sfManagedProjects    SfProject[]    @relation("SfProjectManager")
  sfAssignedTasks      SfProjectTask[] @relation("SfTaskAssignee")

  @@index([role])
}

// Auth.js (NextAuth) adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Fixed-window rate limiting for sensitive endpoints (DB-backed so it works
// across serverless instances).
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// Admin-configurable Entra ID SSO. Single active row (singleton) selected by
// `active`. clientSecretEnc is app-level encrypted.
model SsoSettings {
  id                String   @id @default(cuid())
  active            Boolean  @default(true)
  tenantId          String
  clientId          String
  clientSecretEnc   String   @db.Text
  // Comma/array of domains permitted to sign in, e.g. ["wolfstrata.com"].
  allowedDomains    String[]
  // Optional Entra group object-id -> Role mapping, e.g. { "<groupId>": "OWNER" }.
  groupRoleMappings Json     @default("{}")
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Connectors
// ---------------------------------------------------------------------------

enum ConnectorType {
  TD_SYNNEX_STELLR
  QUICKBOOKS_ONLINE
  HUDU
  SUPEROPS
  SALESFORCE
}

enum ConnectorHealth {
  UNCONFIGURED
  HEALTHY
  DEGRADED
  ERROR
}

model Connector {
  id      String        @id @default(cuid())
  type    ConnectorType @unique
  enabled Boolean       @default(false)

  // Non-secret configuration (environment, region, base URL, realmId, ...).
  config Json @default("{}")
  // App-level encrypted JSON blob of secret material (client secret, tokens).
  secretsEnc String? @db.Text

  health ConnectorHealth @default(UNCONFIGURED)

  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  lastError            String?   @db.Text
  lastSyncDurationMs   Int?
  lastRecordsImported  Int?
  lastRecordsUpdated   Int?
  lastRecordsSkipped   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncRuns  SyncRun[]
  debugLogs DebugLog[]
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model SyncRun {
  id          String        @id @default(cuid())
  connectorId String
  connector   Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  type        ConnectorType
  status      SyncStatus    @default(RUNNING)
  trigger     String // "manual" | "cron" | "test"

  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  recordsImported  Int       @default(0)
  recordsUpdated   Int       @default(0)
  recordsSkipped   Int       @default(0)
  error            String?   @db.Text
  // Optional safe summary of what was synced. Never contains secrets.
  summary          Json?

  startedById String?

  @@index([connectorId, startedAt])
  @@index([type, status])
}

// Admin-only connector debug log. Secrets are NEVER written here; see
// src/lib/debug-log.ts which enforces redaction.
model DebugLog {
  id          String        @id @default(cuid())
  connectorId String?
  connector   Connector?    @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  type        ConnectorType
  environment String? // "sandbox" | "production" | region label

  action       String // human action, e.g. "test_connection", "sync_customers"
  endpoint     String? // path only, query string stripped, no secrets
  httpMethod   String?
  httpStatus   Int?
  durationMs   Int?
  correlationId String?
  recordsRequested Int?
  recordsReturned  Int?
  recordsCreated   Int?
  recordsUpdated   Int?
  recordsSkipped   Int?
  authStatus   String? // "ok" | "refreshed" | "expired" | "failed"
  retryAttempts Int     @default(0)
  rateLimited  Boolean  @default(false)
  outcome      String // "success" | "failure"
  // Safe, redacted error message only.
  message      String? @db.Text

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([connectorId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit log (security-relevant actions)
// ---------------------------------------------------------------------------

enum AuditAction {
  LOGIN
  CONNECTOR_CONFIG_CHANGED
  CONNECTOR_ENABLED
  CONNECTOR_DISABLED
  SYNC_RUN
  MAPPING_CHANGED
  BILLING_RUN_CREATED
  BILLING_RUN_DELETED
  BILLING_LINE_EDITED
  BILLING_RUN_APPROVED
  QBO_INVOICE_PUSHED
  EXPORT
  SSO_SETTINGS_CHANGED
  USER_ROLE_CHANGED
  USER_CREATED
  USER_DISABLED
  USER_ENABLED
  OPPORTUNITY_CREATED
  OPPORTUNITY_UPDATED
  OPPORTUNITY_DELETED
  BACKUP_CREATED
  BACKUP_DELETED
  BACKUP_RESTORED
  SANDBOX_DATA_PURGED
  QUOTA_SET
  REP_COMP_SET
  LEAD_UPDATED
  LEADS_IMPORTED
  LICENSE_ARCHIVED
  LICENSE_UNARCHIVED
  CLIENT_ARCHIVED
  CLIENT_UNARCHIVED
  VIEW_AS_STARTED
  VIEW_AS_STOPPED
  // SilverFang (ticketing / PSA).
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_ASSIGNED
  TICKET_CLOSED
  TICKET_NOTE_ADDED
  TICKET_EMAIL_SENT
  TICKET_EMAIL_RECEIVED
  // Distinct actions rather than one catch-all, so the audit trail can be
  // filtered by what actually changed.
  SF_CONTACT_CREATED
  SF_CONTACT_UPDATED
  SF_CONTACT_DELETED
  SF_CLIENT_PROFILE_UPDATED
  SF_MAILBOX_CHANGED
  SF_EMAIL_POLICY_CHANGED
  TIME_LOGGED
  TIME_ENTRY_UPDATED
  TIMESHEET_SUBMITTED
  TIMESHEET_APPROVED
  AGREEMENT_CREATED
  AGREEMENT_UPDATED
  PROJECT_CREATED
  PROJECT_UPDATED
  SILVERFANG_CONFIG_CHANGED
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?    // denormalized so the record survives user deletion
  // Free-form target reference, e.g. "connector:QUICKBOOKS_ONLINE".
  target    String?
  metadata  Json?       // safe, non-secret context
  ip        String?
  createdAt DateTime    @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Clients (internal master) + source-of-truth records
// ---------------------------------------------------------------------------

model Client {
  id          String  @id @default(cuid())
  // Internal canonical display name (defaults from a source, editable).
  name        String
  notes       String? @db.Text
  active      Boolean @default(true)
  // Finance-user "filed away" flag for an entire client. Archived clients are
  // hidden from the M365 clients list, dashboard math, reports, and the billing
  // client picker, and are managed from the clients list's Archived view.
  archived    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qboCustomer      QboCustomer?
  tdSynnexCustomer TdSynnexCustomer?
  huduMatch        HuduCompany?
  superOpsMatch    SuperOpsClient?

  // Manual client hierarchy: a subsidiary points at its parent. A client has at
  // most one parent, so re-mapping a subsidiary moves it off its old parent.
  parentClientId String?
  parentClient   Client?  @relation("ClientHierarchy", fields: [parentClientId], references: [id], onDelete: SetNull)
  subsidiaries   Client[] @relation("ClientHierarchy")

  billingRuns BillingRun[]
  exceptions  Exception[]
  superOpsInvoices SuperOpsInvoice[]
  crmOpportunities CrmOpportunity[]

  // SilverFang (ticketing / PSA).
  sfClientProfile SfClientProfile?
  sfContacts   SfContact[]
  sfTickets    SfTicket[]
  sfAgreements SfAgreement[]
  sfProjects   SfProject[]
  // Mailboxes that file unrecognised senders against this client.
  sfMailboxFallbacks SfMailbox[]

  @@index([name])
  @@index([parentClientId])
}

// QuickBooks Online customer snapshot.
model QboCustomer {
  id           String  @id @default(cuid())
  clientId     String? @unique
  client       Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  qboId        String  @unique // QBO Customer Id
  realmId      String
  displayName  String
  companyName  String?
  billingEmail String?
  billingAddress Json?
  taxable      Boolean?
  taxStatus    String?
  currency     String?
  paymentTerms String?
  active       Boolean @default(true)
  raw          Json? // safe snapshot; QBO customer data contains no secrets
  lastSyncedAt DateTime @default(now())

  @@index([realmId])
}

// QuickBooks Online item (product/service) snapshot, used for invoice lines
// and SKU mapping.
model QboItem {
  id                 String   @id @default(cuid())
  qboId              String   @unique
  realmId            String
  name               String
  fullyQualifiedName String?
  type               String? // Service, Inventory, NonInventory, ...
  unitPrice          Decimal? @db.Decimal(18, 4)
  active             Boolean  @default(true)
  raw                Json?
  lastSyncedAt       DateTime @default(now())

  @@index([realmId])
  @@index([name])
}

// QuickBooks Online invoice snapshot — powers the Cash-Flow / DSO report.
model QboInvoice {
  id           String    @id @default(cuid())
  qboId        String    @unique
  realmId      String
  customerRef  String? // QBO customer Id
  customerName String?
  docNumber    String?
  txnDate      DateTime // invoice date
  dueDate      DateTime?
  totalAmount  Decimal   @default(0) @db.Decimal(18, 2)
  balance      Decimal   @default(0) @db.Decimal(18, 2)
  currency     String?
  // Home-currency units per one unit of `currency` (QBO ExchangeRate at txn date).
  // 1 for home-currency docs; multiply amounts by this to get the home (CAD) value.
  exchangeRate Decimal   @default(1) @db.Decimal(18, 8)
  termName     String?
  raw          Json?
  lastSyncedAt DateTime  @default(now())

  @@index([realmId])
  @@index([customerRef])
  @@index([txnDate])
}

// QuickBooks Online received-payment snapshot, with per-invoice allocations
// (LinkedTxn) kept in `lines` for cash-weighted DSO / days-late math.
model QboPayment {
  id           String   @id @default(cuid())
  qboId        String   @unique
  realmId      String
  customerRef  String?
  customerName String?
  txnDate      DateTime // payment date
  totalAmount  Decimal  @default(0) @db.Decimal(18, 2)
  currency     String?
  // Home-currency units per foreign unit at the PAYMENT date (rate revenue was received).
  exchangeRate Decimal  @default(1) @db.Decimal(18, 8)
  lines        Json? // [{ invoiceId, amount }]
  raw          Json?
  lastSyncedAt DateTime @default(now())

  @@index([realmId])
  @@index([customerRef])
  @@index([txnDate])
}

// QuickBooks Online vendor bill snapshot — powers the Suppliers & Expenses DPO
// report (how long we take to pay suppliers/expenses).
model QboBill {
  id           String    @id @default(cuid())
  qboId        String    @unique
  realmId      String
  vendorRef    String?
  vendorName   String?
  docNumber    String?
  category     String? // first expense-line account name (for filtering/display)
  memo         String?
  txnDate      DateTime // bill date
  dueDate      DateTime?
  totalAmount  Decimal   @default(0) @db.Decimal(18, 2)
  balance      Decimal   @default(0) @db.Decimal(18, 2)
  currency     String?
  // Home-currency units per foreign unit (QBO ExchangeRate at the bill date).
  exchangeRate Decimal   @default(1) @db.Decimal(18, 8)
  raw          Json?
  lastSyncedAt DateTime  @default(now())

  @@index([realmId])
  @@index([vendorRef])
  @@index([txnDate])
}

// QuickBooks Online bill-payment snapshot, with per-bill allocations (LinkedTxn)
// for days-to-pay (DPO) math.
model QboBillPayment {
  id           String   @id @default(cuid())
  qboId        String   @unique
  realmId      String
  vendorRef    String?
  vendorName   String?
  txnDate      DateTime // payment date
  totalAmount  Decimal  @default(0) @db.Decimal(18, 2)
  currency     String?
  // Home-currency units per foreign unit at the PAYMENT date (rate revenue was paid).
  exchangeRate Decimal  @default(1) @db.Decimal(18, 8)
  lines        Json? // [{ billId, amount }]
  raw          Json?
  lastSyncedAt DateTime @default(now())

  @@index([realmId])
  @@index([vendorRef])
  @@index([txnDate])
}

// TD SYNNEX StreamOne Stellr customer/account snapshot.
model TdSynnexCustomer {
  id            String  @id @default(cuid())
  clientId      String? @unique
  client        Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  stellrId      String  @unique // StreamOne customer/account id
  name          String
  domain        String?
  microsoftTenantId String?
  serviceAddress Json?
  active        Boolean @default(true)
  raw           Json?
  lastSyncedAt  DateTime @default(now())

  subscriptions TdSynnexSubscription[]

  @@index([microsoftTenantId])
}

// Microsoft 365 / NCE subscription under a TD SYNNEX customer.
model TdSynnexSubscription {
  id                 String  @id @default(cuid())
  customerId         String
  customer           TdSynnexCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  stellrSubscriptionId String @unique
  productSku         String?
  productName        String?
  // Vendor/publisher (e.g. Microsoft, Cisco). Used to keep this M365 app focused
  // on Microsoft 365 licensing and exclude other vendors TD SYNNEX also resells.
  vendor             String?
  quantity           Int     @default(0)
  unitCost           Decimal? @db.Decimal(18, 4)
  // TD SYNNEX suggested price to bill the end customer (vs unitCost = our cost).
  customerPrice      Decimal? @db.Decimal(18, 4)
  currency           String?

  // NCE commitment metadata.
  commitmentTerm     String? // "monthly" | "annual" | "triennial"
  billingFrequency   String? // "monthly" | "annual"
  startDate          DateTime?
  renewalDate        DateTime?
  cancellationWindowEnds DateTime?
  reducible          Boolean? // false => NCE rules prevent seat reduction
  status             String?
  // Finance-user "filed away" flag. Archived licenses are hidden from the
  // expired report, dashboard counts, and the client profile, and appear only
  // under "M365 Archived Clients". Not touched by the TD SYNNEX sync upsert.
  archived           Boolean  @default(false)
  raw                Json?
  lastSyncedAt       DateTime @default(now())

  changeLogs         TdSynnexSubscriptionChangeLog[]

  @@index([customerId])
  @@index([productSku])
}

// Stellr subscription change-log entries (listSubscriptionChangeLogs). Co-terminous
// seat additions fold into a subscription line's total quantity without changing
// its start date, so the change log is the ONLY source of the real add date +
// seat delta. Stored so mid-month additions can be pro-rated on their own line.
model TdSynnexSubscriptionChangeLog {
  id                   String @id @default(cuid())
  subscriptionId       String
  subscription         TdSynnexSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  stellrSubscriptionId String   // e.g. "411833_1"
  customerNo           String?
  contractNo           String?
  lineNo               Int?
  activityLog          String?  // e.g. "Update Service (NCE Microsoft 365 Copilot ...)"
  changeLog            String?  // free-text change, e.g. "Add 3 seats"
  seatsDelta           Int      @default(0) // parsed signed seat delta (+add / -remove)
  entryDatetime        DateTime
  entryBy              String?
  entrySource          String?
  raw                  Json?
  createdAt            DateTime @default(now())

  // The change log has no stable id; a line's entries are unique by their exact
  // timestamp + text. Prevents duplicate rows on re-sync.
  @@unique([stellrSubscriptionId, entryDatetime, changeLog], name: "uniq_changelog_entry")
  @@index([subscriptionId])
  @@index([entryDatetime])
}

// Hudu / SuperOps records kept for mapping only (core app does not push to them).
model HuduCompany {
  id        String  @id @default(cuid())
  clientId  String? @unique
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  huduId    String  @unique
  name      String

  /// Contact/identity detail Hudu already holds, so SilverFang can show it
  /// without a second system of record.
  nickname    String?
  companyType String?
  address     String? @db.Text
  phone       String?
  website     String?
  idNumber    String?
  /// Deep link back into Hudu — the point of the sync is to get people there fast.
  huduUrl     String?
  archived    Boolean @default(false)

  raw       Json?
  lastSyncedAt DateTime @default(now())

  assets   HuduAsset[]
  articles HuduArticle[]

  @@index([name])
}

/// A Hudu asset (configuration item): server, workstation, network device…
///
/// SECURITY: Hudu is a credential vault. Asset layouts can contain password,
/// secret and confidential field types, and Hudu's password records hold live
/// credentials. This sync stores **no** Hudu password records at all, drops any
/// asset field that is confidential or whose label reads like a secret, and
/// deliberately keeps **no `raw` blob** for assets — a raw copy would reinstate
/// exactly the values that were stripped.
model HuduAsset {
  id        String      @id @default(cuid())
  companyId String
  company   HuduCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  huduId       String  @unique
  name         String
  /// The asset layout's name, e.g. "Server", "Workstation", "Network Device".
  assetLayout  String?
  serial       String?
  model        String?
  manufacturer String?
  primaryMail  String?
  huduUrl      String?
  archived     Boolean @default(false)

  /// Non-secret fields only, as `[{ label, value }]`. See the model comment.
  fields Json?
  /// Count of fields withheld as confidential, so the UI can say so rather than
  /// implying Hudu held nothing more.
  redactedFieldCount Int @default(0)

  huduUpdatedAt DateTime?
  lastSyncedAt  DateTime  @default(now())

  @@index([companyId, name])
  @@index([assetLayout])
}

/// A Hudu knowledge-base article. Titles and links only — the body is never
/// stored, because article content routinely contains embedded credentials and
/// because a documentation system should stay the source of truth for its text.
model HuduArticle {
  id        String       @id @default(cuid())
  companyId String?
  company   HuduCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  huduId  String  @unique
  name    String
  folder  String?
  huduUrl String?
  /// True for a global article that belongs to no single company.
  global  Boolean @default(false)
  archived Boolean @default(false)

  huduUpdatedAt DateTime?
  lastSyncedAt  DateTime  @default(now())

  @@index([companyId, name])
}

model SuperOpsClient {
  id         String  @id @default(cuid())
  clientId   String? @unique
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  superOpsId String  @unique
  name       String
  // Enriched account fields from getClientList/getClient.
  stage          String?
  status         String?
  accountManager String?
  emailDomains   String[] @default([])
  raw        Json?
  lastSyncedAt DateTime @default(now())

  sites     SuperOpsSite[]
  contacts  SuperOpsContact[]
  assets    SuperOpsAsset[]
  contracts SuperOpsContract[]
  tickets   SuperOpsTicket[]
  worklogs  SuperOpsWorklog[]

  @@index([name])
}

// SuperOps client site (location). Child of SuperOpsClient.
model SuperOpsSite {
  id               String @id @default(cuid())
  superOpsClientId String
  superOpsClient   SuperOpsClient @relation(fields: [superOpsClientId], references: [id], onDelete: Cascade)
  superOpsId       String @unique
  name             String?
  timezone         String?
  address          Json?
  raw              Json?
  lastSyncedAt     DateTime @default(now())

  @@index([superOpsClientId])
}

// SuperOps client contact (user). Child of SuperOpsClient.
model SuperOpsContact {
  id               String @id @default(cuid())
  superOpsClientId String
  superOpsClient   SuperOpsClient @relation(fields: [superOpsClientId], references: [id], onDelete: Cascade)
  superOpsId       String @unique
  name             String?
  email            String?
  phone            String?
  role             String?
  raw              Json?
  lastSyncedAt     DateTime @default(now())

  @@index([superOpsClientId])
}

// SuperOps managed asset. Child of SuperOpsClient.
model SuperOpsAsset {
  id                   String @id @default(cuid())
  superOpsClientId     String
  superOpsClient       SuperOpsClient @relation(fields: [superOpsClientId], references: [id], onDelete: Cascade)
  superOpsId           String @unique
  name                 String?
  serialNumber         String?
  platform             String?
  status               String?
  lastCommunicatedTime DateTime?
  raw                  Json?
  lastSyncedAt         DateTime @default(now())

  @@index([superOpsClientId])
}

// SuperOps client contract / agreement. Child of SuperOpsClient.
model SuperOpsContract {
  id               String @id @default(cuid())
  superOpsClientId String
  superOpsClient   SuperOpsClient @relation(fields: [superOpsClientId], references: [id], onDelete: Cascade)
  superOpsId       String @unique
  name             String?
  status           String?
  startDate        DateTime?
  endDate          DateTime?
  raw              Json?
  lastSyncedAt     DateTime @default(now())

  @@index([superOpsClientId])
}

// SuperOps ticket. Child of SuperOpsClient; parent of worklogs.
model SuperOpsTicket {
  id               String @id @default(cuid())
  superOpsClientId String?
  superOpsClient   SuperOpsClient? @relation(fields: [superOpsClientId], references: [id], onDelete: SetNull)
  superOpsId       String @unique
  displayId        String?
  subject          String?
  status           String?
  priority         String?
  technician       String?
  createdTime      DateTime?
  updatedTime      DateTime?
  raw              Json?
  lastSyncedAt     DateTime @default(now())

  worklogs SuperOpsWorklog[]

  @@index([superOpsClientId])
  @@index([updatedTime])
  @@index([status])
}

// SuperOps worklog / timesheet entry. Child of a ticket (and denormalized client).
model SuperOpsWorklog {
  id               String @id @default(cuid())
  ticketId         String?
  ticket           SuperOpsTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  superOpsClientId String?
  superOpsClient   SuperOpsClient? @relation(fields: [superOpsClientId], references: [id], onDelete: SetNull)
  superOpsId       String @unique
  technician       String?
  minutes          Int?
  billable         Boolean?
  notes            String? @db.Text
  entryTime        DateTime?
  raw              Json?
  lastSyncedAt     DateTime @default(now())

  @@index([ticketId])
  @@index([superOpsClientId])
  @@index([entryTime])
}

// Resumable full-history sync checkpoint (e.g. tickets/worklogs), keyed by entity.
model SuperOpsSyncState {
  entity      String    @id // "tickets"
  cursor      String? // last processed updatedTime/id (ISO or opaque)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// SuperOps invoice imported for review + push to QuickBooks. This is a SEPARATE
// billing pipeline from the M365/TD SYNNEX agreement billing (BillingRun).
model SuperOpsInvoice {
  id                 String    @id @default(cuid())
  superOpsId         String    @unique
  clientId           String?
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  superOpsClientName String?
  invoiceNumber      String?
  status             String? // SuperOps-side invoice status
  invoiceDate        DateTime?
  dueDate            DateTime?
  currency           String?
  subtotal           Decimal?  @db.Decimal(18, 4)
  tax                Decimal?  @db.Decimal(18, 4)
  total              Decimal?  @db.Decimal(18, 4)
  raw                Json?
  lastSyncedAt       DateTime  @default(now())

  // Wolf365 review/push workflow.
  reviewStatus String    @default("PENDING") // PENDING | REVIEWED | PUSHED | SKIPPED
  qboInvoiceId String?
  pushedAt     DateTime?
  pushError    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SuperOpsInvoiceLine[]

  @@index([reviewStatus])
  @@index([clientId])
}

model SuperOpsInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     SuperOpsInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 4)
  qboItemId   String?
  raw         Json?

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Mapping (client + SKU/product) with confidence & approval
// ---------------------------------------------------------------------------

enum MappingStatus {
  PROPOSED // deterministic/AI proposal awaiting human review
  CONFIRMED // human approved
  REJECTED
}

enum MappingMethod {
  DETERMINISTIC
  AI_ASSISTED
  MANUAL
  INVOICE_HISTORY // learned automatically from QBO invoice history during sync
}

// Proposed client link between a QBO customer and a TD SYNNEX customer,
// produced by deterministic + AI-assisted matching and confirmed by a human.
model ClientMatchProposal {
  id                 String        @id @default(cuid())
  qboCustomerId      String
  tdSynnexCustomerId String
  confidence         Float
  method             MappingMethod @default(DETERMINISTIC)
  status             MappingStatus @default(PROPOSED)
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([qboCustomerId, tdSynnexCustomerId])
  @@index([status])
}

// Product/SKU mapping between a TD SYNNEX SKU and a QBO item.
model ProductMapping {
  id           String        @id @default(cuid())
  tdSynnexSku  String
  qboItemId    String?
  qboItemName  String?
  status       MappingStatus @default(PROPOSED)
  method       MappingMethod @default(DETERMINISTIC)
  confidence   Float? // 0..1
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tdSynnexSku])
}

// ---------------------------------------------------------------------------
// Pricing rules
// ---------------------------------------------------------------------------

enum PriceRuleScope {
  GLOBAL_MARKUP // default markup applied when no more specific rule matches
  SKU // SKU-specific price/markup
  CUSTOMER // customer-specific pricing
  CUSTOMER_SKU // customer + SKU specific (most specific)
}

model PriceRule {
  id        String         @id @default(cuid())
  scope     PriceRuleScope
  clientId  String?
  sku       String?
  // Exactly one resolution strategy is used per rule.
  markupPct Decimal? @db.Decimal(9, 4) // e.g. 15.0000 => +15%
  fixedUnitPrice Decimal? @db.Decimal(18, 4)
  active    Boolean @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([clientId])
  @@index([sku])
}

// ---------------------------------------------------------------------------
// Billing runs
// ---------------------------------------------------------------------------

enum BillingRunStatus {
  DRAFT
  REVIEWED
  APPROVED
  PUSHED
  PARTIALLY_FAILED
  CANCELLED
}

model BillingRun {
  id          String           @id @default(cuid())
  status      BillingRunStatus @default(DRAFT)
  version     Int              @default(1)

  // Billing period.
  periodStart DateTime
  periodEnd   DateTime
  invoiceDate DateTime

  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdById String?
  approvedById String?
  approvedAt   DateTime?
  pushedAt     DateTime?
  // QBO invoice id created for this run (single invoice per client run).
  qboInvoiceId String?
  pushError    String?   @db.Text

  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines   BillingLine[]
  edits   BillingLineEdit[]

  @@index([status, createdAt])
  @@index([clientId])
}

model BillingLine {
  id           String   @id @default(cuid())
  billingRunId String
  billingRun   BillingRun @relation(fields: [billingRunId], references: [id], onDelete: Cascade)

  // Source references.
  tdSynnexSubscriptionId String?
  qboItemId    String?
  description  String

  quantity     Decimal @db.Decimal(18, 4)
  unitPrice    Decimal @db.Decimal(18, 4)
  // Proration factor 0..1 (days billed / days in period).
  prorationFactor Decimal @default(1) @db.Decimal(9, 6)
  proratedDays Int?
  periodDays   Int?
  discount     Decimal @default(0) @db.Decimal(18, 4)
  adjustment   Decimal @default(0) @db.Decimal(18, 4)
  estimatedCost Decimal? @db.Decimal(18, 4) // TD SYNNEX cost for margin reporting
  taxStatus    String?
  subtotal     Decimal @db.Decimal(18, 4)
  total        Decimal @db.Decimal(18, 4)
  // True for a line covering seats added mid-period (pro-rated from the add day),
  // split off the base subscription line. Shown as its own labeled line item.
  isProratedAddition Boolean @default(false)
  notes        String?

  // Push results.
  qboInvoiceId String?
  pushError    String? @db.Text

  edits BillingLineEdit[]

  @@index([billingRunId])
}

// Immutable trail of who changed which line and when.
model BillingLineEdit {
  id           String   @id @default(cuid())
  billingRunId String
  billingRun   BillingRun @relation(fields: [billingRunId], references: [id], onDelete: Cascade)
  billingLineId String?
  billingLine  BillingLine? @relation(fields: [billingLineId], references: [id], onDelete: SetNull)

  field    String
  oldValue String?
  newValue String?
  editedById String?
  editedByEmail String?
  createdAt DateTime @default(now())

  @@index([billingRunId, createdAt])
}

// ---------------------------------------------------------------------------
// Exceptions / reconciliation queue
// ---------------------------------------------------------------------------

enum ExceptionType {
  UNMAPPED_CLIENT
  UNMAPPED_SKU
  MISSING_QBO_CUSTOMER
  MISSING_PRICE
  INACTIVE_CLIENT
  TAX_MISMATCH
  CURRENCY_MISMATCH
  CONNECTOR_FAILURE
  NAME_MISMATCH
  ADDRESS_MISMATCH
  MISSING_BILLING_EMAIL
  CLIENT_ONLY_IN_QBO
  CLIENT_ONLY_IN_TDSYNNEX
  ACTIVE_STATUS_MISMATCH
  POSSIBLE_DUPLICATE
}

enum ExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Exception {
  id        String          @id @default(cuid())
  type      ExceptionType
  status    ExceptionStatus @default(OPEN)
  severity  String          @default("warning") // "info" | "warning" | "error"
  clientId  String?
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  message   String
  details   Json?
  createdAt DateTime        @default(now())
  resolvedAt DateTime?

  @@index([type, status])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// CRM — sales pipeline for prospective agreements. Self-contained (our own DB);
// separate from the synced billing data. Three lines of business, each a 1/2/3
// year agreement. Managed Services and Managed NOC bill monthly only; M365 can
// bill monthly or yearly.
// ---------------------------------------------------------------------------

enum CrmLine {
  MANAGED_SERVICES
  MANAGED_NOC
  M365
  PRODUCTS
}

enum CrmStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum CrmForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
  OMITTED
}

enum CrmBillingFrequency {
  MONTHLY
  YEARLY
}

enum CrmOpportunityType {
  NEW_BUSINESS
  RENEWAL
  UPSELL
}

model CrmOpportunity {
  id        String  @id @default(cuid())
  line      CrmLine
  name      String

  // Prospect/account this deal is for. Free text because prospects may not yet
  // exist as a synced Client; optionally linked to one when they do.
  accountName String
  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  // Money. The user enters MONTHLY figures (monthlyAmount = MRR, monthlyMargin).
  // amount (= total contract value), marginAmount, marginPercentage and
  // commissionAmount are all DERIVED on save and stored so the forecast can sum
  // contract value directly.
  monthlyAmount    Decimal? @db.Decimal(18, 2)
  monthlyMargin    Decimal? @db.Decimal(18, 2)
  amount           Decimal? @db.Decimal(18, 2) // TCV = monthlyAmount × 12 × termYears
  marginAmount     Decimal? @db.Decimal(18, 2) // monthlyMargin × 12 × termYears
  marginPercentage Decimal? @db.Decimal(6, 2)
  commissionAmount Decimal? @db.Decimal(18, 2) // Managed Services / NOC only

  // Agreement shape.
  termYears        Int                 @default(1) // 1 | 2 | 3
  billingFrequency CrmBillingFrequency @default(MONTHLY)

  // Funnel.
  stage            CrmStage            @default(PROSPECTING)
  probability      Int                 @default(10) // 0–100
  forecastCategory CrmForecastCategory @default(PIPELINE)
  closeDate        DateTime

  // Customer contact email (from Salesforce) — its domain identifies the client
  // for Microsoft 365 touchpoint matching on the My Clients page.
  contactEmail String?

  // Optional extras mirrored from the existing process.
  estimatedInvoiceDate DateTime?
  cashInDate           DateTime?
  lockbox              Boolean             @default(false)
  type                 CrmOpportunityType?
  leadSource           String?
  nextStep             String?
  description          String?

  // Provenance for imported opportunities (e.g. Salesforce). Null for ones
  // created manually in Wolf365. The (sourceSystem, externalId) pair is unique
  // so re-imports upsert instead of duplicating.
  sourceSystem String?
  externalId   String?

  // Set when a user edits an imported opportunity inside Wolf365 (informational
  // "last local edit" marker).
  locallyModifiedAt DateTime?

  // Field-level sync protection: DB column names a user has edited in Wolf365.
  // The Salesforce sync skips exactly these columns so local edits are kept
  // while everything else still syncs. The padlock toggles all/none.
  lockedFields String[] @default([])

  createdById String?
  createdBy   User?    @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceSystem, externalId])
  @@index([line, stage])
  @@index([ownerId])
  @@index([closeDate])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Sales management — quota targets per salesperson. quarter 0 = annual,
// 1–4 = calendar quarters (0 instead of NULL so the composite unique works).
// Attainment is computed from CLOSED_WON opportunity amounts in the period.
model SalesRepComp {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation("SalesRepCompUser", fields: [userId], references: [id], onDelete: Cascade)
  baseSalary                   Decimal  @default(0) @db.Decimal(18, 2)
  // Product commission is a percentage of gross margin on product deals.
  productCommissionPct         Decimal  @default(0) @db.Decimal(6, 3)
  // Services commission follows the standard month-of-MRR schedule (1y=1, 2y=1.5,
  // 3y=2 months); this multiplier scales that schedule per rep (1 = standard).
  servicesCommissionMultiplier Decimal  @default(1) @db.Decimal(6, 3)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model SalesQuota {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation("SalesQuotaUser", fields: [userId], references: [id], onDelete: Cascade)
  year         Int
  quarter      Int     @default(0) // 0 = annual, 1..4 = quarter
  targetAmount Decimal @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, year, quarter])
  @@index([year])
}

// ---------------------------------------------------------------------------
// Leads — fed in from external sources (e.g. a ZoomInfo workflow POSTing to
// /api/leads). String status keeps the migration simple; allowed values:
// NEW | CONTACTED | QUALIFIED | DISQUALIFIED | CONVERTED.
model Lead {
  id         String  @id @default(cuid())
  externalId String? @unique // source id (e.g. ZoomInfo person id)
  firstName  String?
  lastName   String?
  fullName   String?
  company    String?
  title      String?
  email      String?
  phone      String?
  website    String?
  source     String  @default("zoominfo")
  status     String  @default("NEW")
  notes      String? @db.Text
  raw        Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Backups — records of platform backups. A NEON_BRANCH backup is a Neon API
// branch (an instant point-in-time snapshot of the whole database); a
// LOGICAL_EXPORT is a sanitized JSON dump downloaded by an admin. String
// columns (kind/trigger/status) keep the migration simple; allowed values are
// documented inline.
model Backup {
  id           String    @id @default(cuid())
  kind         String // "NEON_BRANCH" | "LOGICAL_EXPORT"
  trigger      String // "MANUAL" | "CRON"
  status       String    @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  neonBranchId String? // Neon branch id when kind = NEON_BRANCH
  branchName   String? // human-readable snapshot name
  sizeBytes    BigInt? // logical export size, if applicable
  error        String?
  expiresAt    DateTime? // retention horizon; pruned past this
  createdById  String?
  createdBy    User?     @relation("BackupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([createdAt])
}

/// Monthly per-subscription snapshot of M365 (TD SYNNEX) cost + customer price,
/// so cost changes can be compared month-over-month. Written by the daily cron.
/// Decoupled (no FK) so history survives subscription churn/resyncs.
model M365CostSnapshot {
  id                   String   @id @default(cuid())
  /// First day of the month (UTC) this snapshot represents.
  periodMonth          DateTime
  stellrSubscriptionId String
  customerId           String
  productSku           String?
  productName          String?
  quantity             Int      @default(0)
  unitCost             Decimal? @db.Decimal(18, 4)
  customerPrice        Decimal? @db.Decimal(18, 4)
  currency             String?
  createdAt            DateTime @default(now())

  @@unique([periodMonth, stellrSubscriptionId])
  @@index([stellrSubscriptionId, periodMonth])
  @@index([customerId, periodMonth])
}

// ---------------------------------------------------------------------------
// SilverFang — first-party ticketing / PSA (ConnectWise-style).
//
// Replaces the read-only SuperOps mirror with Wolf365's own service-delivery
// system: tickets on configurable boards, time entries against charge codes and
// rate tables, agreements (block time / managed services / NOC), SLAs computed
// from business hours, and projects built from templates.
//
// Conventions follow the rest of this schema: cuid ids, createdAt/updatedAt,
// Decimal(18,4) for money and hours, Cascade for owned children, SetNull for
// cross-domain links, denormalized actor email on history rows so the trail
// survives user deletion, and an index on every foreign key.
// ---------------------------------------------------------------------------

enum SfTicketPriority {
  P1 // Critical — business down
  P2 // High — major impact
  P3 // Normal — default
  P4 // Low — scheduled / whenever
}

enum SfTicketSource {
  PORTAL // raised in Wolf365 by a technician
  EMAIL // inbound email
  PHONE
  ALERT // monitoring/RMM alert
  PROJECT // generated from a project task
  RECURRING // generated from a schedule
}

enum SfAgreementType {
  BLOCK_TIME // prepaid hours drawn down by time entries
  MANAGED_SERVICES // recurring all-in support
  MANAGED_NOC // recurring NOC/monitoring
  PROJECT // fixed-scope project work
  TIME_AND_MATERIALS // billed as worked, no inclusions
}

enum SfAgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SfTimeEntryStatus {
  DRAFT // being worked on, editable by the tech
  SUBMITTED // on a submitted timesheet, awaiting approval
  APPROVED // approved, billable to an invoice
  REJECTED // sent back to the tech
  INVOICED // already pushed to an invoice — locked
}

enum SfTimesheetStatus {
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

/// How a project is billed. Hours are tracked identically for both; what differs
/// is what the client sees and how the invoice is built.
enum SfProjectBillingType {
  TIME_AND_MATERIALS // hours billed as worked, hours shown to the client
  FIXED_FEE          // fixed amount per interval; hours are internal only
}

enum SfProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SfTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

// Rate resolution precedence, most specific first. Mirrors PriceRuleScope so the
// same "most specific wins, unresolved rather than invented" algorithm applies.
enum SfRateScope {
  AGREEMENT_SERVICE // this agreement + this charge code
  AGREEMENT // this agreement, any charge code
  CLIENT_SERVICE // this client + this charge code
  CLIENT // this client, any charge code
  SERVICE // this charge code, any client
  GLOBAL // fallback default
}

// When the work happened, for time-of-day rate banding.
enum SfTimeBand {
  ANY // applies regardless of time
  DAY // within business hours
  AFTER_HOURS // outside business hours on a business day
  WEEKEND
  HOLIDAY
}

enum SfSlaTargetKind {
  RESPONSE // first meaningful reply
  RESOLUTION // ticket resolved
}

enum SfChargeCodeKind {
  BILLABLE_WORK // onsite, remote, after-hours, project
  NON_BILLABLE_WORK // presales, internal, warranty
  ADMIN // admin/meetings
  TIME_OFF // vacation, sick, holiday
}

// A service board (queue), e.g. "Service Desk", "Projects", "NOC".
model SfBoard {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)
  // Default SLA applied to tickets opened on this board.
  slaId       String?
  sla         SfSla?  @relation(fields: [slaId], references: [id], onDelete: SetNull)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statuses SfStatus[]
  tickets  SfTicket[]
  clientProfiles SfClientProfile[]
  mailboxes SfMailbox[]

  @@index([slaId])
}

// A configurable ticket status within a board. Kept as a table (not an enum) so
// the workflow can be tailored per board without a migration.
model SfStatus {
  id      String  @id @default(cuid())
  boardId String
  board   SfBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  // Lifecycle semantics used by queues, SLA clocks and reporting.
  isDefault Boolean @default(false) // applied to new tickets
  isOpen    Boolean @default(true) // counts as an open ticket
  isClosed  Boolean @default(false) // terminal
  // True for "waiting on client"-style statuses that pause the SLA clock.
  stopsSlaClock Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets SfTicket[]

  @@unique([boardId, name])
  @@index([boardId, sortOrder])
}

// A client contact — first-party, so SilverFang does not depend on the SuperOps
// mirror it replaces.
model SfContact {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  email     String?
  phone     String?
  mobile    String?
  title     String?
  isPrimary Boolean @default(false)
  active    Boolean @default(true)
  notes     String? @db.Text

  // Provenance for imported contacts, so re-running an import updates rather than
  // duplicating. Null for contacts created by hand in Wolf365. Same
  // (sourceSystem, externalId) convention as CrmOpportunity.
  sourceSystem    String? // e.g. "SUPEROPS"
  externalId      String? // the source system's contact id
  sourceUpdatedAt DateTime?

  /// Set when a human edits this contact inside Wolf365. Once set, the SuperOps
  /// import skips the row, so local corrections are never overwritten by a
  /// re-import. Mirrors CrmOpportunity.locallyModifiedAt.
  locallyModifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets SfTicket[]

  @@unique([sourceSystem, externalId])
  @@index([clientId])
  @@index([email])
}

// SilverFang-specific settings for a central Client. Created on demand, so a
// client needs no row until someone sets one of these.
model SfClientProfile {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Service-delivery owner (free text — techs are Users, account managers may not be).
  accountManager String?
  /// Board new tickets for this client default to.
  defaultBoardId String?
  defaultBoard   SfBoard? @relation(fields: [defaultBoardId], references: [id], onDelete: SetNull)
  /// Agreement new tickets for this client default to (drives rates).
  defaultAgreementId String?
  defaultAgreement   SfAgreement? @relation(fields: [defaultAgreementId], references: [id], onDelete: SetNull)

  /// HARD RULE: SilverFang must never email this client's contacts unless this is
  /// explicitly true. Default false, for every client, forever — including new
  /// clients and clients with no profile row at all, where the absence of a row
  /// is itself a "no". Enforced in the mail transport, not just the UI.
  allowClientEmail Boolean @default(false)

  vip    Boolean @default(false)
  notes  String? @db.Text
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultBoardId])
  @@index([defaultAgreementId])
}

model SfTicket {
  id     String @id @default(cuid())
  // Human-facing sequential number (e.g. 1042), unique across the system.
  number Int    @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  contactId String?
  contact   SfContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  boardId String
  board   SfBoard @relation(fields: [boardId], references: [id], onDelete: Restrict)

  statusId String
  status   SfStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  priority SfTicketPriority @default(P3)
  source   SfTicketSource   @default(PORTAL)

  // Free-form classification (ConnectWise type/subtype/item).
  type    String?
  subtype String?

  summary     String
  description String? @db.Text

  assigneeId String?
  assignee   User?   @relation("SfTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Optional links: what pays for this work, and project context.
  agreementId String?
  agreement   SfAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  projectId String?
  project   SfProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectPhaseId String?
  projectPhase   SfProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)

  projectTaskId String?
  projectTask   SfProjectTask? @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)

  // Estimates and rollups (hours kept at 4dp like other quantities).
  estimatedHours Decimal? @db.Decimal(18, 4)
  actualHours    Decimal  @default(0) @db.Decimal(18, 4)

  // SLA tracking. Due timestamps are computed from the board's SLA + business
  // hours at open time; the *At fields record what actually happened.
  slaId              String?
  sla                SfSla?    @relation(fields: [slaId], references: [id], onDelete: SetNull)
  responseDueAt      DateTime?
  resolutionDueAt    DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  slaResponseBreached Boolean  @default(false)
  slaResolutionBreached Boolean @default(false)
  // Accumulated paused time (minutes) while in a stopsSlaClock status.
  slaPausedMinutes   Int       @default(0)
  slaPausedAt        DateTime?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  createdById    String?
  createdBy      User?   @relation("SfTicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes       SfTicketNote[]
  messages    SfTicketMessage[]
  history     SfTicketHistory[]
  timeEntries SfTimeEntry[]
  slaEvents   SfSlaEvent[]
  calendarLinks SfCalendarLink[]

  @@index([clientId])
  @@index([boardId, statusId])
  @@index([assigneeId])
  @@index([statusId, createdAt])
  @@index([priority, openedAt])
  @@index([agreementId])
  @@index([projectId])
  @@index([projectPhaseId])
}

// A note on a ticket. `internalOnly` notes must NEVER be exposed to a client —
// enforced at the query layer, not just hidden in the UI.
model SfTicketNote {
  id       String   @id @default(cuid())
  ticketId String
  ticket   SfTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body         String  @db.Text
  internalOnly Boolean @default(true)
  // True when this note was emailed to the contact (never for internal notes).
  emailedAt    DateTime?

  authorId    String?
  authorEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

// A support mailbox SilverFang sends from and receives into. Inbound mail is
// polled from here (Microsoft Graph) or POSTed to the ingest webhook; outbound
// replies are sent from the same address so the client sees one conversation.
model SfMailbox {
  id      String  @id @default(cuid())
  /// Mailbox address polled for inbound mail, always stored lowercased.
  address String  @unique
  name    String?

  /// Optional address outbound replies are sent *from*, when it differs from the
  /// polled mailbox. Set this when a front-door address forwards into a real
  /// mailbox (support@ → help@): poll the real one, answer as the front door.
  /// Requires the app's mail policy to cover this address too. Blank = reply
  /// from `address`.
  sendAsAddress String?

  /// Mail received before this instant is never processed. Defaults to when the
  /// mailbox was added, so pointing SilverFang at an established mailbox does not
  /// work through its back catalogue creating tickets.
  ignoreBefore DateTime?

  /// Board new tickets from this mailbox land on. Falls back to the default board.
  boardId String?
  board   SfBoard? @relation(fields: [boardId], references: [id], onDelete: SetNull)

  /// Where a ticket goes when the sender matches no known contact or domain.
  /// Without one, unrecognised senders are refused and counted rather than
  /// filed against a guessed client.
  fallbackClientId String?
  fallbackClient   Client? @relation(fields: [fallbackClientId], references: [id], onDelete: SetNull)

  defaultPriority SfTicketPriority @default(P3)

  /// "GRAPH" (Microsoft 365 shared mailbox) or "RESEND" (outbound only).
  provider String @default("GRAPH")

  inbound  Boolean @default(true)
  outbound Boolean @default(true)
  active   Boolean @default(true)

  /// Appended to outbound replies, after a separator.
  signature String? @db.Text

  /// Poll bookkeeping. `lastMessageAt` is the receivedDateTime watermark — only
  /// mail newer than this is fetched, and dedupe still guards re-delivery.
  lastPolledAt  DateTime?
  lastMessageAt DateTime?
  lastPollError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SfTicketMessage[]

  @@index([active, inbound])
  @@index([boardId])
  @@index([fallbackClientId])
}

// An email tied to a ticket, inbound or outbound. Threading headers are stored
// so replies land on the right ticket.
model SfTicketMessage {
  id       String   @id @default(cuid())
  ticketId String
  ticket   SfTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Which mailbox sent or received this message (null for legacy/unknown).
  mailboxId String?
  mailbox   SfMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  direction  String // "INBOUND" | "OUTBOUND"
  fromAddress String
  toAddresses String[] @default([])
  ccAddresses String[] @default([])
  subject    String?
  bodyText   String? @db.Text
  bodyHtml   String? @db.Text

  // RFC 5322 threading.
  messageId  String? @unique
  inReplyTo  String?
  references String?

  sentAt     DateTime?
  receivedAt DateTime?
  // Provider/Graph id, for dedupe on re-ingest.
  externalId String?
  raw        Json?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([externalId])
  @@index([mailboxId, receivedAt])
}

// Immutable field-level change trail for a ticket (mirrors BillingLineEdit).
model SfTicketHistory {
  id       String   @id @default(cuid())
  ticketId String
  ticket   SfTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  field    String
  oldValue String?
  newValue String?

  changedById    String?
  changedByEmail String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// A work/charge code: onsite, remote, after-hours, presales, admin, vacation…
model SfChargeCode {
  id   String @id @default(cuid())
  code String @unique
  name String
  kind SfChargeCodeKind @default(BILLABLE_WORK)
  // Default billability for time logged against this code.
  billableDefault Boolean @default(true)
  // Default multiplier (e.g. 1.5 for after-hours) applied when no rate rule
  // provides one. Kept at 3dp like other multipliers in this schema.
  defaultMultiplier Decimal? @db.Decimal(6, 3)
  active Boolean @default(true)
  sortOrder Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries SfTimeEntry[]
  rateRules   SfRateRule[]
  techDefaults SfTechProfile[]

  @@index([active, sortOrder])
}

// A rate rule. Resolution picks the most specific matching active rule (see
// SfRateScope) and prefers a fixedRate over a multiplier, exactly like PriceRule.
model SfRateRule {
  id    String      @id @default(cuid())
  scope SfRateScope
  // Scope keys — which are set depends on `scope`.
  clientId     String?
  agreementId  String?
  agreement    SfAgreement? @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  chargeCodeId String?
  chargeCode   SfChargeCode? @relation(fields: [chargeCodeId], references: [id], onDelete: Cascade)

  timeBand SfTimeBand @default(ANY)

  // An hourly rate, or a multiplier applied to the next-less-specific rate.
  fixedRate  Decimal? @db.Decimal(18, 4)
  multiplier Decimal? @db.Decimal(6, 3)
  // Internal cost rate, for margin reporting.
  costRate   Decimal? @db.Decimal(18, 4)

  active    Boolean @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, active])
  @@index([clientId])
  @@index([agreementId])
  @@index([chargeCodeId])
}

// Weekly timesheet container for a technician.
model SfTimesheet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SfTimesheetUser", fields: [userId], references: [id], onDelete: Cascade)

  // Monday of the week (UTC), so a week is identified unambiguously.
  weekStart DateTime
  status    SfTimesheetStatus @default(OPEN)

  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedById  String?
  approvedByEmail String?
  rejectionNote String? @db.Text

  totalHours    Decimal @default(0) @db.Decimal(18, 4)
  billableHours Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries SfTimeEntry[]

  @@unique([userId, weekStart])
  @@index([status, weekStart])
}

model SfTimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SfTimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)

  ticketId String?
  ticket   SfTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  projectPhaseId String?
  projectPhase   SfProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)

  projectTaskId String?
  projectTask   SfProjectTask? @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)

  agreementId String?
  agreement   SfAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  chargeCodeId String
  chargeCode   SfChargeCode @relation(fields: [chargeCodeId], references: [id], onDelete: Restrict)

  timesheetId String?
  timesheet   SfTimesheet? @relation(fields: [timesheetId], references: [id], onDelete: SetNull)

  // The work date (date-only semantics, stored UTC midnight) plus optional
  // start/end for techs who track precisely.
  workDate  DateTime
  startedAt DateTime?
  endedAt   DateTime?
  hours     Decimal @db.Decimal(18, 4)

  notes        String? @db.Text
  internalOnly Boolean @default(false) // keep these notes off client-facing output

  billable  Boolean @default(true)
  timeBand  SfTimeBand @default(ANY)
  // Resolved at log time so later rate changes don't rewrite history.
  rate      Decimal? @db.Decimal(18, 4)
  costRate  Decimal? @db.Decimal(18, 4)
  amount    Decimal? @db.Decimal(18, 4)

  status SfTimeEntryStatus @default(DRAFT)
  // Set once the entry has been pushed onto an invoice.
  invoicedAt   DateTime?
  qboInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockDraws SfAgreementBlockDraw[]

  @@index([userId, workDate])
  @@index([ticketId])
  @@index([status, workDate])
  @@index([agreementId])
  @@index([timesheetId])
}

model SfAgreement {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name   String
  type   SfAgreementType
  status SfAgreementStatus @default(DRAFT)

  startDate DateTime
  endDate   DateTime?
  autoRenew Boolean  @default(false)

  // Recurring billing (managed services / NOC).
  billingFrequency String? // "MONTHLY" | "YEARLY" — string per house precedent
  monthlyAmount    Decimal? @db.Decimal(18, 2)
  // Hours included per period before overage applies.
  includedHours    Decimal? @db.Decimal(18, 4)
  overageRate      Decimal? @db.Decimal(18, 4)
  // Default rate when no rate rule matches.
  standardRate     Decimal? @db.Decimal(18, 4)

  notes String? @db.Text

  createdById    String?
  createdByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks     SfAgreementBlock[]
  tickets    SfTicket[]
  projects   SfProject[]
  timeEntries SfTimeEntry[]
  rateRules  SfRateRule[]
  clientProfiles SfClientProfile[]

  @@index([clientId, status])
  @@index([type, status])
}

// A purchased block of prepaid hours. Balance is derived from the draw ledger so
// it is always auditable rather than a mutable counter.
model SfAgreementBlock {
  id          String      @id @default(cuid())
  agreementId String
  agreement   SfAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  purchasedHours Decimal   @db.Decimal(18, 4)
  rate           Decimal?  @db.Decimal(18, 4)
  amount         Decimal?  @db.Decimal(18, 2)
  purchasedAt    DateTime  @default(now())
  expiresAt      DateTime?
  poNumber       String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draws SfAgreementBlockDraw[]

  @@index([agreementId, purchasedAt])
}

// One drawdown of block hours by a time entry (append-only ledger).
model SfAgreementBlockDraw {
  id      String           @id @default(cuid())
  blockId String
  block   SfAgreementBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  timeEntryId String?
  timeEntry   SfTimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  hours     Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())

  @@index([blockId, createdAt])
  @@index([timeEntryId])
}

model SfSla {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)
  // When false, SLA clocks run on calendar time instead of business hours.
  useBusinessHours Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets       SfSlaTarget[]
  businessHours SfBusinessHours[]
  holidays      SfHoliday[]
  boards        SfBoard[]
  tickets       SfTicket[]

  @@index([active])
}

// Response/resolution target per priority, in minutes.
model SfSlaTarget {
  id    String @id @default(cuid())
  slaId String
  sla   SfSla  @relation(fields: [slaId], references: [id], onDelete: Cascade)

  priority SfTicketPriority
  kind     SfSlaTargetKind
  minutes  Int

  @@unique([slaId, priority, kind])
  @@index([slaId])
}

// Business-hours window for one weekday (0=Sunday … 6=Saturday), in the SLA's
// timezone. Minutes-from-midnight avoids any date/DST ambiguity.
model SfBusinessHours {
  id    String @id @default(cuid())
  slaId String
  sla   SfSla  @relation(fields: [slaId], references: [id], onDelete: Cascade)

  weekday     Int // 0-6
  startMinute Int // e.g. 480 = 08:00
  endMinute   Int // e.g. 1020 = 17:00
  timezone    String @default("America/Winnipeg")

  @@unique([slaId, weekday])
  @@index([slaId])
}

model SfHoliday {
  id    String @id @default(cuid())
  slaId String
  sla   SfSla  @relation(fields: [slaId], references: [id], onDelete: Cascade)

  name String
  // Date-only (UTC midnight).
  date DateTime

  @@unique([slaId, date])
  @@index([slaId, date])
}

// SLA clock event trail for a ticket: started, paused, resumed, met, breached.
model SfSlaEvent {
  id       String   @id @default(cuid())
  ticketId String
  ticket   SfTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  kind      String // "STARTED" | "PAUSED" | "RESUMED" | "RESPONDED" | "RESOLVED" | "BREACHED"
  targetKind SfSlaTargetKind?
  note      String?
  occurredAt DateTime @default(now())

  @@index([ticketId, occurredAt])
}

model SfProject {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  agreementId String?
  agreement   SfAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  name        String
  description String? @db.Text
  status      SfProjectStatus @default(PLANNED)

  managerId String?
  manager   User?   @relation("SfProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  startDate DateTime?
  dueDate   DateTime?
  closedAt  DateTime?

  billingType SfProjectBillingType @default(TIME_AND_MATERIALS)

  /// Fixed-fee amount billed each `billingIntervalDays`. Only meaningful for
  /// FIXED_FEE; hours stay internal on that type and must never reach the client.
  fixedFeeAmount      Decimal? @db.Decimal(18, 2)
  billingIntervalDays Int      @default(30)

  /// Up-front deposit as a percentage of the total, and what was actually
  /// invoiced for it. Stored rather than always recomputed so a later change to
  /// the total cannot rewrite an invoice that already went out.
  depositPercent   Decimal?  @db.Decimal(5, 2)
  depositAmount    Decimal?  @db.Decimal(18, 2)
  depositInvoicedAt DateTime?

  /// Hours sold for this project — the quantity the client agreed to, distinct
  /// from the internal estimate. Overage is measured against this. For a phased
  /// project this is the sum of its phase hours.
  contractedHours Decimal? @db.Decimal(18, 4)
  estimatedHours Decimal? @db.Decimal(18, 4)
  budgetAmount   Decimal? @db.Decimal(18, 2)

  // Set when instantiated from a template, for reporting.
  templateId String?
  template   SfProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdById    String?
  createdByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases  SfProjectPhase[]
  tasks   SfProjectTask[]
  tickets SfTicket[]

  @@index([clientId, status])
  @@index([managerId])
  @@index([status, dueDate])
}

/// A stage of a project. Created as "Phase 1", "Phase 2"… and renamable. Hours
/// are sold per phase and sum to the project's contracted total, so a phased
/// project's quantity is built from its parts rather than typed twice.
model SfProjectPhase {
  id        String    @id @default(cuid())
  projectId String
  project   SfProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)
  /// Hours sold for this phase.
  hours     Decimal? @db.Decimal(18, 4)
  status    SfTaskStatus @default(NOT_STARTED)
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       SfProjectTask[]
  tickets     SfTicket[]
  timeEntries SfTimeEntry[]

  @@index([projectId, sortOrder])
}

// A project task ("ticklet"): the unit of work techs log time against.
model SfProjectTask {
  id        String    @id @default(cuid())
  projectId String
  project   SfProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Structured phase. `phase` (the free string) predates this and is kept so
  /// existing rows and template tasks still render.
  projectPhaseId String?
  projectPhase   SfProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)

  phase     String?
  name      String
  description String? @db.Text
  sortOrder Int     @default(0)
  status    SfTaskStatus @default(NOT_STARTED)

  assigneeId String?
  assignee   User?   @relation("SfTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  estimatedHours Decimal? @db.Decimal(18, 4)
  actualHours    Decimal  @default(0) @db.Decimal(18, 4)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries SfTimeEntry[]
  tickets     SfTicket[]

  @@index([projectId, sortOrder])
  @@index([projectPhaseId])
  @@index([assigneeId])
  @@index([status])
}

model SfProjectTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks    SfProjectTemplateTask[]
  projects SfProject[]

  @@index([active])
}

model SfProjectTemplateTask {
  id         String            @id @default(cuid())
  templateId String
  template   SfProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  phase          String?
  name           String
  description    String? @db.Text
  sortOrder      Int     @default(0)
  estimatedHours Decimal? @db.Decimal(18, 4)
  // Days after project start that this task is due (relative scheduling).
  dueOffsetDays  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId, sortOrder])
}

// Automatic email/notification rules (e.g. acknowledge on create, notify on
// status change). Bodies are templates rendered at send time.
model SfAutoResponseRule {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  // "TICKET_CREATED" | "STATUS_CHANGED" | "NOTE_ADDED" | "SLA_BREACHED"
  trigger String
  // Optional narrowing.
  boardId  String?
  statusId String?
  priority SfTicketPriority?

  // "CONTACT" | "ASSIGNEE" | "BOTH"
  audience String @default("CONTACT")

  subjectTemplate String
  bodyTemplate    String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, trigger])
}

// Per-technician SilverFang settings. One row per Wolf365 user who works tickets.
model SfTechProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String?
  // Default charge code applied to new time entries.
  defaultChargeCodeId String?
  defaultChargeCode   SfChargeCode? @relation(fields: [defaultChargeCodeId], references: [id], onDelete: SetNull)

  // Per-tech overrides used when no rate rule provides a rate.
  billRate Decimal? @db.Decimal(18, 4)
  costRate Decimal? @db.Decimal(18, 4)

  // Mailbox/UPN used for Outlook calendar sync via Microsoft Graph.
  calendarMailbox String?
  calendarSyncEnabled Boolean @default(false)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([defaultChargeCodeId])
}

// Link between a SilverFang record and an Outlook calendar event, so sync can
// update/delete the right event rather than creating duplicates.
model SfCalendarLink {
  id       String    @id @default(cuid())
  ticketId String?
  ticket   SfTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Graph event identity.
  mailbox  String
  eventId  String
  iCalUid  String?

  startAt  DateTime
  endAt    DateTime
  syncedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mailbox, eventId])
  @@index([ticketId])
}

// Field-level change trail for SilverFang records that have no history table of
// their own (contacts, client profiles, mailboxes, agreements, projects…).
// Tickets keep SfTicketHistory, which predates this and is queried per ticket.
//
// Append-only by convention: rows are written on change and never updated, so
// "who changed what, from what, when" survives later edits and deletions.
model SfChangeLog {
  id String @id @default(cuid())

  /// Model name, e.g. "SfContact" — kept as a string so a new entity needs no
  /// migration to become auditable.
  entity   String
  entityId String
  /// Human-readable label at the time of the change, so a deleted record still
  /// reads sensibly in the trail.
  entityLabel String?

  /// Field name, or "*" for whole-record events like creation and deletion.
  field    String
  oldValue String? @db.Text
  newValue String? @db.Text

  /// "CREATE" | "UPDATE" | "DELETE"
  operation String @default("UPDATE")

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}

// Master switch for ALL outbound SilverFang email. Single row, keyed on a fixed
// id so it can be upserted without a lookup.
//
// HARD RULE: when this is off — including when the row does not exist — nothing
// outbound is sent at all, to clients or technicians. It sits above the
// per-client "Allow email to client" gate: both must be on for a client to be
// mailed. Off is the default, and stays the default.
model SfEmailPolicy {
  id              String  @id @default("singleton")
  outboundEnabled Boolean @default(false)

  /// Who last changed it, denormalized so the record survives user deletion.
  updatedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Monotonic ticket-number source, so numbers don't depend on row counts.
model SfCounter {
  name  String @id // e.g. "ticket"
  value Int    @default(0)
}
