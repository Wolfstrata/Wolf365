# =============================================================================
# Wolf365 environment configuration
#
# Copy to .env.local for local development. In production these are configured
# as Vercel Environment Variables. NEVER commit real secrets.
#
# Connector credentials (TD SYNNEX, QuickBooks, Hudu, SuperOps) are NOT stored
# here. They are entered by an admin in the app and encrypted at rest in the
# database using WOLF365_ENCRYPTION_KEY.
# =============================================================================

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection string used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Application encryption key ----------------------------------------------
# Retired keys, DECRYPTION ONLY, comma-separated base64. Set only during a key
# rotation, so values written under the previous key still open while
# Administration -> Security & SSO re-encrypts them. Remove once that page reports
# everything is under the current key — removing it early makes those values
# permanently unreadable.
# WOLF365_ENCRYPTION_KEYS_OLD=""

# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes existing encrypted secrets unreadable. Plan rotation.
WOLF365_ENCRYPTION_KEY=""

# --- Auth.js (NextAuth) ------------------------------------------------------
# Secret used to sign/encrypt session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Canonical app URL (used for OAuth redirect URIs). e.g. https://wolf365.example.com
AUTH_URL="http://localhost:3000"

# --- Bootstrap admin ---------------------------------------------------------
# Email addresses (comma-separated) granted OWNER role on first login, so the
# very first sign-in can configure SSO and connectors. Optional once seeded.
WOLF365_BOOTSTRAP_ADMINS=""

# --- First-run Entra SSO bootstrap (optional) --------------------------------
# Used ONLY until SSO is configured in-app (Security & SSO page). Lets the
# bootstrap admin sign in to set up SSO. After that, manage SSO in the app.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# --- Vercel Cron -------------------------------------------------------------
# Shared secret Vercel injects as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
# Debug-log retention window in days (30-90 typical).
WOLF365_DEBUG_LOG_RETENTION_DAYS="30"

# --- Backups (Neon snapshots) ------------------------------------------------
# Neon control-plane API access used to create database backups (branch
# snapshots) on-demand and on the daily cron. Generate an API key at
# https://console.neon.tech/app/settings/api-keys and find the project id under
# the project's Settings → General. Leave blank to disable Neon backups (the
# JSON data export still works).
NEON_API_KEY=""
NEON_PROJECT_ID=""
# How long Neon backup branches are kept before automatic pruning.
BACKUP_RETENTION_DAYS="30"
# Optional: the production/default branch id that "Restore from snapshot"
# overwrites. Leave blank to auto-detect the project's default branch.
NEON_BRANCH_ID=""
#
# IMPORTANT: A Neon snapshot contains the app-encrypted connector secrets, but
# they are UNRECOVERABLE without WOLF365_ENCRYPTION_KEY. Back that key up
# separately, out-of-band (e.g. a password manager / secrets vault). It is NOT
# stored in the database and therefore NOT in any snapshot.

# --- Lead ingestion ------------------------------------------------------------
# Bearer token external workflows (e.g. ZoomInfo) use to POST leads to
# /api/leads. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The endpoint refuses all requests until this is set.
WOLF365_LEADS_TOKEN=""

# --- SilverFang inbound email --------------------------------------------------
# Bearer token a mail forwarder / Power Automate flow uses to POST inbound ticket
# email to /api/silverfang/email. Generate the same way as the lead token above.
# The endpoint refuses all requests until this is set.
#
# Only needed for the webhook route. If the support mailbox is a Microsoft 365
# mailbox, SilverFang polls it directly via Graph every 15 minutes instead — that
# path needs Mail.ReadWrite + Mail.Send *application* permissions consented on
# the same Entra app registration used for sign-in, and no token here.
WOLF365_SILVERFANG_EMAIL_TOKEN=""

# --- Support contact ---------------------------------------------------------
# Where the in-app "Contact support" link points. An email (rendered as a
# mailto:) or an http(s) support URL. Defaults to rperumal@wolfstrata.com.
WOLF365_SUPPORT_CONTACT="rperumal@wolfstrata.com"

# --- Runtime -----------------------------------------------------------------
NODE_ENV="development"
